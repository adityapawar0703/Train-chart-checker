PORT=4000

# Monitoring Interval (default is 8 minutes: 480000 ms)
CHECK_INTERVAL_MS=480000

# Resend API Key for Email Notifications (Preferred free email provider)
# Get a free key at https://resend.com/
RESEND_API_KEY=your_resend_api_key_here

# Notification email / Account owner email (for Resend free tier unverified domain)
NOTIFICATION_EMAIL=your_email@example.com

# Optional custom sender email (defaults to "IRCTC Alert <onboarding@resend.dev>")
RESEND_FROM="IRCTC Alert <onboarding@resend.dev>"

# IRCTC API Endpoint
IRCTC_CHART_URL=https://www.irctc.co.in/online-charts/api/trainComposition

# Optional testing / simulation flags
# Set MOCK_IRCTC=true to test monitoring flow when IRCTC blocks local requests
MOCK_IRCTC=false
# Set MOCK_CHART_PREPARED=true to simulate chart prepared on checks
MOCK_CHART_PREPARED=false
